{
  "name": "brainbight",
  "version": "0.1.0",
  "private": true,
  "description": "A cross-platform accessibility-first gesture and voice-control workspace.",
  "workspaces": ["web", "admin", "backend", "mobile"],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:web": "npm run dev --workspace=web",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:mobile": "npm run start --workspace=mobile",
    "build": "npm run build --workspace=web && npm run build --workspace=admin",
    "start:backend": "npm start --workspace=backend"
  }
}
